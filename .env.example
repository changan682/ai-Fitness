# ============================================================
#  AI 健身私教 & 体态管家 —— 环境变量模板（可提交到 Git）
# ============================================================
#  用法：
#     cp .env.example .env      # Windows PowerShell: Copy-Item .env.example .env
#     然后按自己的中间件地址/密码修改 .env
#
#  .env 已被 .gitignore 忽略，本模板不含任何真实密码，可以安全提交。
#
#  Java 侧生效原理：application.yml 配了
#     spring.config.import: optional:file:.env[.properties]
#  所以 Spring Boot 会把项目根目录的 .env 当 properties 读入；
#  「optional:」前缀表示文件不存在也不报错（用 application.yml 里的默认值）。
#  ⚠️ 工作目录必须是项目根目录（mvn spring-boot:run 与 IDEA 默认如此）。
#
#  Python 侧是独立文件：python-agent/.env（同样已被 gitignore）。
# ============================================================


# ---------- Spring 环境 ----------
SPRING_PROFILES_ACTIVE=dev


# ---------- MySQL（业务数据库）----------
MYSQL_HOST=192.168.199.128
MYSQL_PORT=3306
MYSQL_DATABASE=fitness_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password


# ---------- Redis（缓存 / 分布式锁 / Token 黑名单）----------
REDIS_HOST=192.168.199.128
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password


# ---------- RabbitMQ（第7周启用异步链路）----------
RABBITMQ_HOST=192.168.199.128
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agent1
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/agent1


# ---------- Python AI Agent（本机 FastAPI）----------
AI_PYTHON_URL=http://localhost:8000


# ---------- 安全密钥 ----------
# JWT 签名密钥：至少 32 字节，生产环境必须替换为随机值
JWT_SECRET=change-me-to-a-random-32-bytes-or-longer
# Python → Java 回调的 HMAC-SHA256 共享密钥，两侧必须一致
# 签名原文（两侧必须逐字符一致，覆盖了请求体，防篡改）：
#   canonical = method + "\n" + path + "\n" + X-Timestamp + "\n" + sha256Hex(rawBody)
#   X-Signature = HMAC-SHA256(canonical, HMAC_SECRET) 的十六进制小写
# Java 侧必须用原始请求体（ContentCachingRequestWrapper）算哈希，并校验时间戳偏移 ≤5 分钟防重放。
HMAC_SECRET=change-me-hmac-shared-secret
