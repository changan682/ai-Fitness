# ============================================================
# Python Agent 服务环境变量示例
# 用法：复制为 .env 后按需修改（Copy-Item .env.example .env）
# 所有键都有代码内默认值，.env 可以不存在
#
# ⚠️ .env 已被 .gitignore 忽略（含真实 Key），本示例不含任何密钥，可安全提交。
# ============================================================

# ---------- 服务自身 ----------
# 监听地址：0.0.0.0 允许局域网/容器访问，127.0.0.1 仅本机
AGENT_HOST=0.0.0.0
# 监听端口（Java 侧 ai.python.base-url 默认 http://localhost:8000）
AGENT_PORT=8000
# 环境标识：dev / test / prod
AGENT_ENV=dev
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：text（开发，人读）/ json（生产，结构化，便于采集）
LOG_FORMAT=text


# ============================================================
# 运行模式开关（第 5 周起语义已明确）
# ============================================================

# MOCK_MODE：是否**跳过真实大模型调用**（省额度 / 无 Key 时也能跑）
#   true  → 训练总结走本地拼装；知识问答走「真实 Milvus 检索 + 本地拼装回答」
#   false → 调用 DeepSeek 生成（需 DEEPSEEK_API_KEY）
# ⚠️ 本开关**只影响大模型**。Milvus / Embedding / 知识库检索始终走真实实现 ——
#    它们属于和 MySQL/Redis 一样的本地依赖，把它们 mock 掉等于白白丢弃已导入的 200 条知识。
MOCK_MODE=true

# 启动时自动初始化知识库（规范第 3544 行要求「启动时自动完成」）。
# 幂等：已导入则跳过，不会重复 Embedding。
AUTO_INIT_KNOWLEDGE=true

# 强制重建知识库：忽略已有数据，全量重新 Embedding 并导入。
# ⚠️ **换 Embedding 模型后必须置 true 一次**，否则新旧向量的语义空间不一致，
#    检索结果会莫名其妙（例如从兜底的 hashing 切到百炼 text-embedding-v3 时）。
FORCE_RELOAD_KNOWLEDGE=false

# 故障注入接口开关：true 时暴露 GET /agent/v1/_debug/fault?mode=500|slow|400，
# 供 Java 侧验证 RestClient 降级链路（6001 AI_TIMEOUT / 6002 AI_RESPONSE_ERROR）
ENABLE_FAULT_INJECTION=false


# ============================================================
# 大模型（第 5 周启用）
# ============================================================
# DeepSeek API Key：https://platform.deepseek.com 申请。可留空，
# 留空时 /agent/v1/health 的 llm_api_configured=false，训练总结自动走本地拼装。
# 严禁提交到 Git；日志里只打印脱敏值（utils.mask_secret 已处理）。
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com


# ============================================================
# Embedding（第 5 周启用）—— RAG 的语义检索质量取决于这里
# ============================================================

# 供应商选择：auto / dashscope / siliconflow / local / hashing
#   auto        （默认）按已配置的 Key 自动选择：有百炼 Key 用 dashscope，
#               有硅基流动 Key 用 siliconflow，都没有则退化到 hashing
#   dashscope   阿里云百炼 text-embedding-v3 —— **推荐**，因为第 6 周的
#               「姿态评估」本来就需要通义千问 VL，用同一家只需维护一个 Key
#   siliconflow 硅基流动 BAAI/bge-base-zh-v1.5（原生 768 维）
#   local       本地 sentence-transformers 跑 text2vec-base-chinese（768 维，免费，但要下 ~400MB 模型、
#               装数 GB 的 torch）
#   hashing     离线兜底：字符 n-gram 哈希向量，**无需任何 Key**。
#               它只能命中词法相近的内容（语义改写检索不到），
#               用于在没有 Key 的环境下验证 Milvus + RAG 全链路是否通。
#
# ⚠️ 规范里把「DeepSeek Embedding」列为备选，但 **DeepSeek 并不提供 Embedding 接口**
#    （见 deepseek-ai/DeepSeek-V3 issue #806），因此这里没有 deepseek 这个取值。
EMBEDDING_PROVIDER=auto

# 向量维度：规范硬性要求 768（与 shibing624/text2vec-base-chinese 的 hidden size 对齐）。
# ⚠️ text2vec-large-chinese 是 1024 维，不得与 768 维 Collection 混用（insert 时会抛维度不匹配）。
# 换模型时必须先确认新模型输出维度：维度变了就要同步改这里 + FORCE_RELOAD_KNOWLEDGE=true 重建索引
# （Milvus Collection 的 dim 建好后不能直接改），因为不同模型的向量不在同一语义空间。
EMBEDDING_DIM=768

# 单次请求最多提交多少条文本做向量化。
# 百炼 text-embedding-v3 限制单次最多 10 条，超过直接报错，因此代码里会分批提交。
EMBEDDING_BATCH_SIZE=10

# --- 阿里云百炼（DashScope，OpenAI 兼容接口）---
# 申请地址：https://bailian.console.aliyun.com
# 填了这一项，EMBEDDING_PROVIDER=auto 就会自动切到 dashscope
# ⚠️ 同一个 Key 同时用于 Embedding 与**多模态（姿态评估）**，
#    但**权限是分开的**：Embedding 能用不代表 qwen-vl-* 已开通（会返回 403 access_denied）。
#    开工前跑 `check_api_keys.py` 一次探活，三项都要 PASS。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# --- 多模态（第 6 周：姿态评估）---
# 实测可用：qwen-vl-max（默认，判断质量最好）/ qwen-vl-plus（更便宜）
# 实测不可用（403 未开通）：qwen-vl-max-latest、qwen2.5-vl-7b-instruct
QWEN_VL_MODEL=qwen-vl-max
# 单次调用超时（秒）。姿态评估是同步接口，不能让 Java 请求线程长时间挂住。
MULTIMODAL_TIMEOUT_SECONDS=60.0
# 重试次数：仅对网络异常 / 429 / 5xx 生效，4xx（鉴权/未开通/参数）立刻失败
MULTIMODAL_MAX_RETRIES=1

# --- 硅基流动（可选）---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# --- 本地模型（EMBEDDING_PROVIDER=local 时才用）---
# 固定 text2vec-base-chinese：hidden size = 768，与 Collection 的 dim 严格对齐。
# ⚠️ 不要用 text2vec-large-chinese（1024 维），会与 768 维 Collection 维度不匹配。
LOCAL_EMBEDDING_MODEL=shibing624/text2vec-base-chinese


# ============================================================
# Milvus 向量库（第 5 周启用）
# ============================================================
# 由项目根目录的 docker-compose.yml 启动（milvus + etcd + minio）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=fitness_knowledge

# 索引与检索参数：**必须与数据规模匹配**（nlist 经验值 ≈ √N）
# 知识库 N=200 → √200≈14，故 nlist=16、nprobe=4（nprobe 必须与 nlist 配套）。
# ⚠️ 严禁用 nlist=128 这类远超 √N 的取值：每个聚类只分到 1-2 条向量，聚类近似失效、召回率反降。
#    数据量增长到万级后，再按 √N 重新调整 nlist 与 nprobe。
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_NLIST=16
MILVUS_NPROBE=4

# RAG 检索返回条数（规范：Top-5）
RAG_TOP_K=5


# ============================================================
# Java 回调（第 7 周 MQ 回调使用）
# ============================================================
# Python 生成周计划后回调 Java 的地址（规范 8.1）
JAVA_CALLBACK_URL=http://localhost:8080
# 回调 HMAC-SHA256 共享密钥。
# 签名原文（必须覆盖请求体，否则 body 被篡改签名依然有效）：
#   canonical = method + "\n" + path + "\n" + X-Timestamp + "\n" + sha256Hex(rawBody)
#   X-Signature = HMAC-SHA256(canonical, HMAC_SECRET)   # 十六进制小写
# ⚠️ 必须与 Java 侧 .env 的 HMAC_SECRET 完全一致，否则回调会被判为「签名校验失败」(9002)
HMAC_SECRET=change-me-hmac-shared-secret


# ============================================================
# 姿态评估入参体积上限
# ============================================================
# Base64 字符串**解码后**允许的最大字节数（默认 1.5MB）。
# Java 侧已先把图片压缩到 ≤1MB 再转 Base64，这里是 Python 侧的防御性校验：
# 超大图一次性解码会申请数十 MB 内存，几个并发就能把进程打爆。
# 超限按参数错误（HTTP 400，Java 侧 9003）拒绝，提示语是「图片过大…请压缩后再上传」。
# 注：模型层（models.py 的 max_length=2_000_000 字符）正好对应解码后 1.5MB，
#     所以默认配置下极超限的请求会先被 Pydantic 拦成 422（更粗的一道网）；
#     把本值调小于 1.5MB 时，就是这里的 400 分支给用户更友好的提示。
POSE_MAX_DECODED_IMAGE_BYTES=1500000


# ============================================================
# RabbitMQ（第 7 周启用：周计划消费者）
# ============================================================
# 虚拟机 192.168.199.128:5672，vhost=/agent1（与 Java 侧一致）
RABBITMQ_HOST=192.168.199.128
RABBITMQ_PORT=5672
# vhost 是与账号**独立**的一层命名空间：连错 vhost 时账号密码都对，
# 但队列会「不存在」（NOT_FOUND），排查时很容易误判成「队列没声明」。
RABBITMQ_VHOST=/agent1
RABBITMQ_USER=agent1
# 占位符：请填你自己虚拟机上的真实密码（**不要**把真实密码写回本文件——
# 本文件是要提交进 Git 的模板，真实值只应出现在被 gitignore 的 .env 里）。
RABBITMQ_PASSWORD=your-rabbitmq-password

# 队列 / 交换机 / routing key：必须与 Java 侧 RabbitMQConfig + WeeklyPlanProducer 完全一致，
# 否则消息发出去但没人消费（不报错，只在 MQ 控制台看到消息堆积）。
#   Java 生产者：rabbitTemplate.convertAndSend("ai.fitness.exchange", "ai.weekly.plan.request", msg)
# ⚠️ 队列、TTL（x-message-ttl=3600000）、死信（ai.fitness.dlx → ai.weekly.plan.dlq）
#    全部由 **Java 端声明**；消费者刻意**不声明队列**（参数差一个字节就会 PRECONDITION_FAILED）。
RABBITMQ_QUEUE=ai.weekly.plan
RABBITMQ_EXCHANGE=ai.fitness.exchange
RABBITMQ_ROUTING_KEY=ai.weekly.plan.request

# --- 消息重试（Redis 计数）---
# 同一 taskId 失败后重投的次数上限；超过后 basic_nack(requeue=False) 送入死信队列人工排查。
# 规范要求：只有「LLM 生成成功 **且** 回调 Java 成功」才允许 basic_ack，
# 任何一步失败都必须重投 —— 先 ACK 再回调会导致任务永久丢失。
MQ_MAX_RETRIES=3
# 重试计数的 TTL（秒）：与规范伪代码一致取 3600，
# 避免「某天反复失败」的计数永久留在 Redis 里，把后续同样的 taskId 直接判死。
MQ_RETRY_TTL_SECONDS=3600

# 【预留开关，当前未接入 app/main.py】是否随 FastAPI 应用启动消费者。
# 现在的部署方式是**独立长驻进程**：`python -m app.mq_consumer`（另开终端，支持 --once 只处理一条）。
# 不绑进 Web 服务的原因：--reload 重启 / 多 worker / pytest 都会各起一个消费者，
# 同一条消息会被多个进程抢；且 FastAPI 一启动就要连 MQ（没装 pika 时连服务都起不来）。
MQ_ENABLED=false

# --- Redis（重试计数用）---
REDIS_HOST=192.168.199.128
REDIS_PORT=6379
# ⚠️ 虚拟机的 Redis 开了 requirepass（与 Java 侧根目录 .env 的 REDIS_PASSWORD 保持一致）。
#    留空会报 NOAUTH：重试计数写不进去，失败消息会一直重投而不会进死信队列。
# 占位符：请填真实密码，不要写回本文件（本文件会提交进 Git）。
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
